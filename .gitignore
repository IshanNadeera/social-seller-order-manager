dist/
build/
coverage/
*.tsbuildinfo

# Test output
playwright-report/
test-results/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
# Local JWT signing keys (private keys; each developer generates their own)
supabase/signing_keys.json

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
