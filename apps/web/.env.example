# Web app environment (docs/DEVELOPMENT.md §10.4). Copy to apps/web/.env for local development.
# PUBLIC VALUES ONLY: every VITE_ variable is compiled into the JavaScript sent to browsers.
# The dev server and build refuse to start if a VITE_ variable looks like a secret.

# Base URL of the API, including the /api/v1 prefix.
VITE_API_URL=http://localhost:3000/api/v1

# Supabase project URL and its public anon (publishable) key. Locally, `npx supabase status`
# prints the anon key (task A8).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-local-anon-key

# Never add the service-role / secret key here.
