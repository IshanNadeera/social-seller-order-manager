{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    // Set explicitly: TypeScript 6 defaults rootDir to this folder, which would emit dist/src/main.js
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
