# API environment (docs/DEVELOPMENT.md §10.4). Copy to apps/api/.env for local development.
# Placeholders only. The connection values below are the public defaults of the local Supabase CLI
# stack (npx supabase start), not real credentials. Staging and production values live in the
# host's secret settings, never in a file in this repository.
# The API checks these at startup (src/common/env.ts) and refuses to start if any is missing or invalid.

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Runtime database connection through the Supabase pooler (session pooler, or the transaction
# pooler on port 6543 with ?pgbouncer=true). Locally: the CLI's Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Session-level connection for Prisma CLI migrations (prisma.config.ts). Not read by the running API.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL (origin only, no trailing slash) and the issuer of its access tokens.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Exact origin of the web app, for CORS (scheme + host + port, no trailing slash).
WEB_ORIGIN=http://localhost:5173

# Error monitoring DSN (task F5). Optional; leave empty locally.
SENTRY_DSN=

# Never add the Supabase service-role / secret key. This API does not need it, and it refuses to
# start if a variable with SERVICE_ROLE or SUPABASE_SECRET in its name is set.
